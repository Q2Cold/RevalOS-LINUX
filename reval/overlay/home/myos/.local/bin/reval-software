def tr(message):
    language = (
        os.environ.get("LC_ALL")
        or os.environ.get("LC_MESSAGES")
        or os.environ.get("LANG", "en")
    ).split("_")[0].split(".")[0].lower()
    if language == "ru":
        return message
    versions = TRANSLATIONS.get(message)
    if versions is None:
        return message
    return versions[1] if language == "kk" else versions[0]

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

nix = shutil.which("nix") or "/nix/var/nix/profiles/default/bin/nix"

window = Gtk.Window(title=tr("Программы Reval OS"))
window.set_default_size(760, 520)
window.set_border_width(14)
window.connect("destroy", Gtk.main_quit)

box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
window.add(box)

notebook = Gtk.Notebook()
box.pack_start(notebook, True, True, 0)

catalog_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
catalog_page.set_border_width(8)
notebook.append_page(catalog_page, Gtk.Label(label=tr("Каталог")))
installed_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
installed_page.set_border_width(8)
notebook.append_page(installed_page, Gtk.Label(label=tr("Установленные")))

advanced_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
advanced_box.set_border_width(8)
notebook.append_page(advanced_box, Gtk.Label(label=tr("Дополнительно")))
entry = Gtk.Entry()
entry.set_placeholder_text(tr("Название пакета"))
advanced_box.pack_start(entry, False, False, 0)
row = Gtk.Box(spacing=8)
advanced_box.pack_start(row, False, False, 0)

status_row = Gtk.Box(spacing=8)
status_row.set_no_show_all(True)
box.pack_start(status_row, False, False, 0)
status = Gtk.Label(label="")
status.set_halign(Gtk.Align.START)
status.set_line_wrap(True)
status_row.pack_start(status, True, True, 0)

def status_changed(*_):
    status_row.set_visible(bool(status.get_text()))

status.connect("notify::label", status_changed)

view = Gtk.TextView()
view.set_editable(False)
view.set_monospace(True)
view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
buffer = view.get_buffer()

scroll = Gtk.ScrolledWindow()
scroll.set_hexpand(True)
scroll.set_vexpand(True)
scroll.add(view)
journal_label = Gtk.Label(label=tr("Подробности"))
journal_label.set_xalign(0)
advanced_box.pack_start(journal_label, False, False, 0)
advanced_box.pack_start(scroll, True, True, 0)
spinner = Gtk.Spinner()
spinner.set_no_show_all(True)
status_row.pack_start(spinner, False, False, 0)
status.show()
busy = False

def on_close(*_):
    if busy:
        status.set_text(tr("Дождись завершения операции перед закрытием окна."))
    return busy

window.connect("delete-event", on_close)

buttons = []

# Reval OS installed table
store = Gtk.ListStore(str, str)
table = Gtk.TreeView(model=store)
for index, title in enumerate((tr("Программа"), tr("Пакет"))):
    column = Gtk.TreeViewColumn(
        title, Gtk.CellRendererText(), text=index
    )
    column.set_resizable(True)
    table.append_column(column)

installed_scroll = Gtk.ScrolledWindow()
installed_scroll.set_size_request(-1, 170)
installed_scroll.add(table)
installed_page.pack_start(installed_scroll, True, True, 0)
installed_attributes = set()

def show_installed(data):
    store.clear()
    installed_attributes.clear()
    for name, item in sorted(data["elements"].items()):
        attribute = item.get("attrPath") or ""
        prefix = "legacyPackages.x86_64-linux."
        if attribute.startswith(prefix):
            attribute = attribute[len(prefix):]
        store.append([name, attribute])
        if item.get("active", True):
            installed_attributes.add(attribute)
    filter_catalog()
    append(tr("Установлено программ: ") + str(len(store)) + "\n")
    return False

def selected_name():
    model, iterator = table.get_selection().get_selected()
    return model[iterator][0] if iterator is not None else None

def append(text):
    text = re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '', text)
    buffer.insert(buffer.get_end_iter(), text)
    return False

def done(code):
    global busy
    busy = False
    spinner.stop()
    spinner.hide()
    if code != 0:
        notebook.set_current_page(2)
    for button in buttons:
        button.set_sensitive(True)
    entry.set_sensitive(True)
    update_actions()
    status.set_text("" if code == 0 else tr("Ошибка — смотри вывод ниже"))
    return False

def execute(args):
    global busy
    if busy:
        return
    if not (os.path.isfile(nix) and os.access(nix, os.X_OK)):
        status.set_text(tr("Nix не найден. Запусти магазин внутри Reval OS."))
        return
    busy = True
    spinner.show()
    spinner.start()
    if args == ["profile", "history"]:
        notebook.set_current_page(2)
    for button in buttons:
        button.set_sensitive(False)
    entry.set_sensitive(False)
    buffer.set_text("")
    status.set_text(tr("Выполняется…"))

    def worker():
        code = 1
        try:
            command = [nix, "--extra-experimental-features",
                       "nix-command flakes"] + (args + ["--json"] if args == ["profile", "list"] else args)
            environment = dict(os.environ, NO_COLOR="1", TERM="dumb")
            if args == ["profile", "list"]:
                result = subprocess.run(command, capture_output=True, text=True,
                                        errors="replace", env=environment)
                code = result.returncode
                if result.stderr:
                    GLib.idle_add(append, result.stderr)
                if code == 0:
                    data = json.loads(result.stdout)
                    if not isinstance(data.get("elements"), dict):
                        raise ValueError(tr("Неожиданный формат списка Nix"))
                    GLib.idle_add(show_installed, data)
                else:
                    GLib.idle_add(append, result.stdout)
            else:
                with subprocess.Popen(command, stdout=subprocess.PIPE,
                                      stderr=subprocess.STDOUT, text=True,
                                      errors="replace", env=environment) as process:
                    for line in process.stdout:
                        GLib.idle_add(append, line)
                    code = process.wait()
                if code == 0 and args[:2] in (["profile", "add"],
                                               ["profile", "remove"],
                                               ["profile", "rollback"]):
                    refresh = subprocess.run(
                        [nix, "--extra-experimental-features", "nix-command flakes",
                         "profile", "list", "--json"], capture_output=True,
                        text=True, errors="replace", env=environment)
                    if refresh.stderr:
                        GLib.idle_add(append, refresh.stderr)
                    if refresh.returncode != 0:
                        GLib.idle_add(append, refresh.stdout)
                        code = refresh.returncode
                    else:
                        data = json.loads(refresh.stdout)
                        if not isinstance(data.get("elements"), dict):
                            raise ValueError(tr("Неожиданный формат списка Nix"))
                        GLib.idle_add(show_installed, data)
            if code == 0:
                GLib.idle_add(append, tr("\nОперация завершена.\n"))
        except Exception as error:
            code = 1
            GLib.idle_add(append, str(error) + "\n")
        finally:
            GLib.idle_add(done, code)

    threading.Thread(target=worker, daemon=True).start()

def confirm(message):
    dialog = Gtk.MessageDialog(
        transient_for=window, modal=True,
        message_type=Gtk.MessageType.QUESTION,
        buttons=Gtk.ButtonsType.OK_CANCEL,
        text=message
    )
    answer = dialog.run()
    dialog.destroy()
    return answer == Gtk.ResponseType.OK

def package():
    name = entry.get_text().strip()
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.+-]*", name):
        status.set_text(tr("Введи имя пакета без пробелов, например geany"))
        return None
    return name

def install(_):
    name = package()
    if name:
        execute(["profile", "add", "nixpkgs#" + name])

def remove(_):
    name = selected_name()
    if not name:
        status.set_text(tr("Выбери программу в таблице"))
        return
    if name and confirm(tr("Удалить пакет «") + name + tr("» из профиля Nix?")):
        execute(["profile", "remove", name])

def rollback(_):
    if confirm(tr("Вернуть предыдущую версию всего профиля Nix?")):
        execute(["profile", "rollback"])

def button(title, callback):
    widget = Gtk.Button(label=title)
    widget.connect("clicked", callback)
    row.pack_start(widget, False, False, 0)
    buttons.append(widget)

# Reval OS starter catalog
catalog = [
    ("geany", tr("Редактор кода и небольшая среда разработки")),
    ("galculator", tr("Калькулятор")),
    ("htop", tr("Просмотр процессов и нагрузки")),
    ("tree", tr("Дерево файлов и каталогов")),
    ("git", tr("Управление версиями исходного кода")),
    ("ripgrep", tr("Быстрый поиск текста в файлах")),
    ("jq", tr("Обработка данных JSON")),
    ("tmux", tr("Несколько терминалов в одном окне")),
    ("nano", tr("Простой текстовый редактор в терминале")),
    ("neovim", tr("Расширяемый редактор кода")),
    ("python3", tr("Язык программирования Python")),
    ("nodejs", tr("Среда выполнения JavaScript")),
    ("rustc", tr("Компилятор языка Rust")),
    ("cargo", tr("Сборка проектов и зависимости Rust")),
    ("cmake", tr("Подготовка сборки программ")),
    ("gnumake", tr("Инструмент сборки Make")),
    ("gdb", tr("Отладчик программ")),
    ("shellcheck", tr("Проверка ошибок в shell-скриптах")),
    ("strace", tr("Просмотр системных вызовов программы")),
    ("curl", tr("Сетевые запросы и загрузка файлов")),
    ("wget", tr("Загрузка файлов")),
    ("btop", tr("Монитор ресурсов в терминале")),
]

# The local catalog is searched without evaluating all of Nixpkgs.
query = Gtk.SearchEntry()
query.set_placeholder_text(tr("Например: редактор, Python, процессы"))
catalog_page.pack_start(query, False, False, 0)
notice = Gtk.Label(label=tr("Стартовый каталог Reval OS — не весь Nixpkgs"))
notice.set_xalign(0)
notice.set_line_wrap(True)
query.set_tooltip_text(tr("Стартовый каталог Reval OS — не весь Nixpkgs"))
results = Gtk.ListStore(str, str, str)
listing = Gtk.TreeView(model=results)
for index, title in enumerate((tr("Программа"), tr("Описание"), tr("Состояние"))):
    renderer = Gtk.CellRendererText()
    column = Gtk.TreeViewColumn(title, renderer, text=index)
    column.set_resizable(True)
    if index == 1:
        column.set_expand(True)
    listing.append_column(column)
area = Gtk.ScrolledWindow()
area.set_hexpand(True)
area.set_vexpand(True)
area.add(listing)
catalog_page.pack_start(area, True, True, 0)

def filter_catalog(*_):
    needle = query.get_text().strip().casefold()
    results.clear()
    for name, description in catalog:
        if needle in (name + " " + description).casefold():
            results.append([name, description,
                            tr("Установлено") if name in installed_attributes else ""])

def update_actions(*_):
    model, iterator = listing.get_selection().get_selected()
    selected = model[iterator][0] if iterator is not None else None
    catalog_install.set_sensitive(not busy and selected is not None
                                  and selected not in installed_attributes)
    remove_button.set_sensitive(not busy and selected_name() is not None)

def install_selected(*_):
    model, iterator = listing.get_selection().get_selected()
    if iterator is not None and not busy:
        name = model[iterator][0]
        if name not in installed_attributes:
            execute(["profile", "add", "nixpkgs#" + name])

catalog_install = Gtk.Button(label=tr("Установить"))
catalog_install.connect("clicked", install_selected)
catalog_install.set_halign(Gtk.Align.END)
catalog_page.pack_start(catalog_install, False, False, 0)
buttons.append(catalog_install)

installed_actions = Gtk.Box(spacing=8)
installed_page.pack_start(installed_actions, False, False, 0)
remove_button = Gtk.Button(label=tr("Удалить"))
remove_button.connect("clicked", remove)
refresh_button = Gtk.Button(label=tr("Обновить список"))
refresh_button.connect("clicked", lambda _: execute(["profile", "list"]))
for widget in (remove_button, refresh_button):
    installed_actions.pack_start(widget, False, False, 0)
    buttons.append(widget)

button(tr("Установить по имени пакета"), install)
button(tr("История"), lambda _: execute(["profile", "history"]))
button(tr("Откат"), rollback)
query.connect("search-changed", filter_catalog)
listing.get_selection().connect("changed", update_actions)
table.get_selection().connect("changed", update_actions)
filter_catalog()
update_actions()
window.show_all()
execute(["profile", "list"])
Gtk.main()
