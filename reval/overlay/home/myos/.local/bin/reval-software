TRANSLATIONS.update({
    'Дополнительно': ('Advanced', 'Қосымша'),
    'Обновить список': ('Refresh list', 'Тізімді жаңарту'),
    'Установить по имени пакета': ('Install by package name', 'Пакет атауы бойынша орнату'),
