#!/usr/bin/python3
import os
import subprocess
import threading
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

texts = {
    "en": ["Language and region", "Interface language", "Regional formats",
           "Time zone", "Apply", "Applying…",
           "Saved. Log out and back in to apply the language.",
           "Error: ", "These settings apply to the whole system."],
    "ru": ["Язык и регион", "Язык интерфейса", "Региональные форматы",
           "Часовой пояс", "Применить", "Применение…",
           "Сохранено. Для смены языка выйди и войди в сеанс.",
           "Ошибка: ", "Эти настройки действуют для всей системы."],
    "kk": ["Тіл және аймақ", "Интерфейс тілі", "Аймақтық пішімдер",
           "Уақыт белдеуі", "Қолдану", "Қолданылуда…",
           "Сақталды. Тілді өзгерту үшін сеанстан шығып, қайта кіріңіз.",
           "Қате: ", "Бұл баптаулар бүкіл жүйеге қолданылады."]
}
code = os.environ.get("LANG", "en").split("_")[0]
t = texts.get(code, texts["en"])

languages = [
    ("en_US.UTF-8", "English"),
    ("ru_RU.UTF-8", "Русский"),
    ("kk_KZ.UTF-8", "Қазақша")
]
regions = [
    ("kk_KZ.UTF-8", "Қазақстан"),
    ("ru_RU.UTF-8", "Россия"),
    ("en_US.UTF-8", "United States")
]

def run(args):
    return subprocess.run(
        args, check=True, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE
    ).stdout.strip()

settings = {}
try:
    with open("/etc/locale.conf") as f:
        for line in f:
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.strip().split("=", 1)
                settings[key] = value.strip("\"'")
except FileNotFoundError:
    pass

zones = run(["timedatectl", "list-timezones", "--no-pager"]).splitlines()
current_zone = run(["timedatectl", "show", "-p", "Timezone", "--value"])

window = Gtk.Window(title=t[0])
window.set_default_size(480, 280)
window.set_border_width(18)
window.connect("destroy", Gtk.main_quit)

grid = Gtk.Grid(column_spacing=16, row_spacing=14)
window.add(grid)

def combo(row, title, choices, current):
    label = Gtk.Label(label=title)
    label.set_halign(Gtk.Align.START)
    box = Gtk.ComboBoxText()
    box.set_hexpand(True)
    for value, name in choices:
        box.append(value, name)
    box.set_active_id(current)
    grid.attach(label, 0, row, 1, 1)
    grid.attach(box, 1, row, 1, 1)
    return box

language = combo(0, t[1], languages,
                 settings.get("LANG", "en_US.UTF-8"))
region = combo(1, t[2], regions,
              settings.get("LC_TIME", settings.get("LANG", "en_US.UTF-8")))
timezone = combo(2, t[3], [(z, z) for z in zones], current_zone)

notice = Gtk.Label(label=t[8])
notice.set_line_wrap(True)
grid.attach(notice, 0, 3, 2, 1)

button = Gtk.Button(label=t[4])
grid.attach(button, 1, 4, 1, 1)

status = Gtk.Label()
status.set_line_wrap(True)
status.set_selectable(True)
grid.attach(status, 0, 5, 2, 1)

def finish(message):
    button.set_sensitive(True)
    status.set_text(message)
    return False

def apply(_button):
    lang = language.get_active_id()
    reg = region.get_active_id()
    zone = timezone.get_active_id()
    if not all((lang, reg, zone)):
        status.set_text(t[7] + "Select all three values.")
        return

    button.set_sensitive(False)
    status.set_text(t[5])

    def worker():
        completed = []
        try:
            run(["pkexec", "/usr/bin/localectl", "set-locale",
                 "LANG=" + lang, "LC_TIME=" + reg,
                 "LC_NUMERIC=" + reg, "LC_MONETARY=" + reg,
                 "LC_PAPER=" + reg])
            completed.append(t[1] + ", " + t[2])
            run(["pkexec", "/usr/bin/timedatectl", "set-timezone", zone])
            GLib.idle_add(finish, t[6])
        except subprocess.CalledProcessError as e:
            detail = (e.stderr or e.stdout or str(e)).strip()
            message = t[7] + detail
            if completed:
                message += "\n✓ " + "; ".join(completed)
            GLib.idle_add(finish, message)
        except Exception as e:
            GLib.idle_add(finish, t[7] + str(e))

    threading.Thread(target=worker, daemon=True).start()

button.connect("clicked", apply)
window.show_all()
Gtk.main()
